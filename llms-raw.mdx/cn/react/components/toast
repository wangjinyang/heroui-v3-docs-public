          size="sm"
          variant="secondary"
          onPress={() =>
            toast("更改已保存", {
              onClose: () => {
                addToHistory("更改已保存（10 秒后关闭）");
              },
              timeout: 10000,
            })
          }
        >
          自定义超时（10 秒）
