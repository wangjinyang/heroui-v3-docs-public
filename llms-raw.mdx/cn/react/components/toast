                addToHistory("重要通知（手动关闭）");
              },
              timeout: 0,
            })
          }
        >
          持久显示 Toast
        </Button>
      </div>

      {/* 关闭历史 Panel */}
      <div className="w-full space-y-2">
        <div className="flex items-center justify-between">
